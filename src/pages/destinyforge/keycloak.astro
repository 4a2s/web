---
const groups = [
  { id: "son", name: "Son" },
  { id: "3d", name: "3D" },
  { id: "dev", name: "Développement" },
  { id: "histoire", name: "Histoire" },
];
---

<h1>Choisir mes groupes</h1>

<p>
  Sélectionnez les groupes auxquels vous souhaitez appartenir.
</p>

<form>
  {
    groups.map((group) => (
      <label>
        <input
          type="checkbox"
          name="groups"
          value={group.id}
        />
        {group.name}
      </label>
    ))
  }

  <button type="submit">
    Enregistrer
  </button>
</form>